__pycache__/
*.pyc
tools/tre/node_modules/
tools/tre/package-lock.json
eseguibile/node_modules/
eseguibile/package-lock.json
eseguibile/pagina/
eseguibile/dist/

# Doppioni dei pupazzi di Meshy: nel gioco si usa solo *_3d_animato.glb (stessa mesh, con lo scheletro)
art/plastilina/personaggi/*_3d.glb
art/plastilina/personaggi/*_3d_scheletro.glb

# La stanza ad alta qualita': i modelli e i materiali di Poly Haven si riscaricano con tools/stanza_hq.py
art/stanza_hq/sorgenti/
# la luce cotta grezza (EXR, decine di MB) e l'esportazione intermedia: nel gioco vanno i WebP di gioco/modelli/hq
art/stanza_hq/luce/
art/stanza_hq/uscita/

# Gli strumenti per le lingue (tools/lingua): si reinstallano con npm install
tools/lingua/node_modules/
tools/lingua/package-lock.json
# i pezzi delle traduzioni mentre si lavora (il lavoro finito e' parti/*_en.json)
tools/lingua/parti/*_en_[0-9]*.json
# l'illustrazione ingrandita da ESRGAN per l'hero di Steam (19 MB): si rifa con art/steam/lavori_ingrandisci.json
art/steam/illustrazione_larga_x2.png

# Il trailer (tools/trailer): le riprese fotogramma per fotogramma (GB di JPEG) e i video montati (oltre i 100 MB che
# GitHub accetta per file) si rifanno con riprese.js e monta.py
art/steam/trailer/riprese/
art/steam/trailer/cartelli/
art/steam/trailer/*.mp4
art/steam/trailer/*.wav
art/steam/trailer/tagli_*.jpg
