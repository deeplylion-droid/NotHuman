; Il prototipo del gioco delle cento porte (3 novembre 2026: «mi fai una prova con godot di solo la stanza e la porta,
; e l'animazione di picchiarla. Suoni effetti e tutto, fino a buttarla giù. Niente menu né niente, solo questo»)

config_version=5

[application]

config/name="Porte (prototipo)"
run/main_scene="res://scene/bunker.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Effetti="*res://script/effetti.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="disabled"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
textures/vram_compression/import_s3tc_bptc=true
environment/volumetric_fog/volume_size=96
